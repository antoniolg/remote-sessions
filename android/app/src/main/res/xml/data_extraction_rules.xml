<?xml version="1.0" encoding="utf-8"?>
<!-- Tokens are encrypted with a Keystore key that is not backed up, so keep paired computers off backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
