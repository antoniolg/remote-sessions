    "NSLocalNetworkUsageDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Sessions verbindet sich im lokalen Netzwerk mit deinem Computer, um deine Unterhaltungen mit Claude Code anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
