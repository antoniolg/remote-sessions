    "Can't find %@. Check that it's turned on, that the server is running and that you're both on the same Wi-Fi or on Tailscale." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde nicht gefunden. Prüfe, ob der Computer eingeschaltet ist, der Server läuft und Handy und Computer im selben WLAN oder in Tailscale sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encuentra %@. Comprueba que está encendido, que el servidor está en marcha y que estáis en la misma wifi o en Tailscale."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de trouver %@. Vérifiez qu’il est allumé, que le serveur est en marche et que le téléphone et l’ordinateur sont sur le même Wi-Fi ou sur Tailscale."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak ditemukan. Pastikan komputer menyala, server berjalan, serta ponsel dan komputer berada di Wi-Fi yang sama atau di Tailscale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile trovare %@. Controlla che sia acceso, che il server sia in esecuzione e che telefono e computer siano sulla stessa Wi-Fi o su Tailscale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が見つかりません。電源が入っていること、サーバが起動していること、スマートフォンとコンピュータが同じ Wi-Fi または Tailscale に接続していることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 찾을 수 없습니다. 컴퓨터가 켜져 있는지, 서버가 실행 중인지, 휴대폰과 컴퓨터가 같은 Wi-Fi 또는 Tailscale에 연결되어 있는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is niet gevonden. Controleer of de computer aanstaat, de server draait en je telefoon en computer op hetzelfde wifinetwerk of op Tailscale zitten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można znaleźć: %@. Sprawdź, czy komputer jest włączony, serwer działa, a telefon i komputer są w tej samej sieci Wi-Fi lub w Tailscale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível encontrar %@. Verifique se ele está ligado, se o servidor está rodando e se o celular e o computador estão no mesmo Wi-Fi ou no Tailscale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся найти %@. Убедитесь, что компьютер включён, сервер запущен, а телефон и компьютер находятся в одной сети Wi-Fi или в Tailscale."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bulunamadı. Bilgisayarın açık olduğunu, sunucunun çalıştığını ve telefonla bilgisayarın aynı Wi-Fi ağında ya da Tailscale'de olduğunu kontrol et."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 %@。请检查它是否已开机、服务器是否正在运行，以及手机和电脑是否在同一 Wi-Fi 或 Tailscale 网络中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 %@。請確認電腦已開機、伺服器正在執行，且手機與電腦位於同一個 Wi-Fi 或 Tailscale 網路中。"
          }
        }
      }
    },
