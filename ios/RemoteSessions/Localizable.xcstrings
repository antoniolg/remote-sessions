          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora você pode ver suas conversas enquanto estiver no mesmo Wi-Fi que o computador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь вы можете видеть разговоры, пока находитесь в одной сети Wi-Fi с компьютером."
          }
        },
        "tr" : {
          "stringUnit" : {
