    "A different computer answered at that address. Scan the code again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dieser Adresse antwortet ein anderer Computer. Scanne den Code erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En esa dirección responde otro ordenador. Vuelve a escanear el código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre ordinateur répond à cette adresse. Scannez à nouveau le code."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komputer lain merespons di alamat itu. Pindai kodenya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quell’indirizzo risponde un altro computer. Scansiona di nuovo il codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのアドレスでは別のコンピュータが応答しています。コードをもう一度スキャンしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 주소에서 다른 컴퓨터가 응답했습니다. 코드를 다시 스캔하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op dat adres reageert een andere computer. Scan de code opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod tym adresem odpowiada inny komputer. Zeskanuj kod ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro computador respondeu nesse endereço. Escaneie o código de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По этому адресу отвечает другой компьютер. Отсканируйте код ещё раз."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu adreste başka bir bilgisayar yanıt veriyor. Kodu yeniden tara."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该地址上响应的是另一台电脑。请重新扫描二维码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該位址上回應的是另一台電腦。請重新掃描 QR Code。"
          }
        }
      }
    },
