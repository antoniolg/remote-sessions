    "Swipe to forget a computer. To revoke access from the computer, run `remote-sessions pair --rotate`." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische, um einen Computer zu entfernen. Um den Zugriff vom Computer aus zu widerrufen, führe `remote-sessions pair --rotate` aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza para olvidar un ordenador. Para revocar el acceso desde el ordenador, ejecuta `remote-sessions pair --rotate`."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez pour oublier un ordinateur. Pour révoquer l’accès depuis l’ordinateur, exécutez `remote-sessions pair --rotate`."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesek untuk melupakan komputer. Untuk mencabut akses dari komputer, jalankan `remote-sessions pair --rotate`."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri per dimenticare un computer. Per revocare l’accesso dal computer, esegui `remote-sessions pair --rotate`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スワイプするとコンピュータの登録を解除できます。コンピュータ側でアクセスを取り消すには、`remote-sessions pair --rotate` を実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터를 삭제하려면 스와이프하세요. 컴퓨터에서 액세스를 취소하려면 `remote-sessions pair --rotate`를 실행하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg om een computer te vergeten. Voer `remote-sessions pair --rotate` uit om de toegang vanaf de computer in te trekken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń, aby zapomnieć komputer. Aby cofnąć dostęp z poziomu komputera, uruchom `remote-sessions pair --rotate`."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para esquecer um computador. Para revogar o acesso pelo computador, execute `remote-sessions pair --rotate`."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните, чтобы забыть компьютер. Чтобы отозвать доступ с компьютера, выполните `remote-sessions pair --rotate`."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir bilgisayarı unutmak için kaydır. Erişimi bilgisayardan iptal etmek için `remote-sessions pair --rotate` komutunu çalıştır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻扫即可移除电脑。如需在电脑端撤销访问权限，请运行 `remote-sessions pair --rotate`。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑動即可移除電腦。若要從電腦端撤銷存取權，請執行 `remote-sessions pair --rotate`。"
          }
        }
      }
    },
