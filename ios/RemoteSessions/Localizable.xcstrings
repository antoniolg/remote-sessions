    "Remote Control didn't respond in time. Check that Claude Code is signed in with your Claude subscription." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Control hat nicht rechtzeitig geantwortet. Prüfe, ob Claude Code mit deinem Claude-Abo angemeldet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Control no respondió a tiempo. Comprueba que Claude Code tiene la sesión iniciada con tu suscripción de Claude."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Control n’a pas répondu à temps. Vérifiez que Claude Code est connecté avec votre abonnement Claude."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Control tidak merespons tepat waktu. Pastikan Claude Code sudah masuk dengan langganan Claude Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Control non ha risposto in tempo. Controlla che Claude Code abbia effettuato l’accesso con il tuo abbonamento a Claude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Control が時間内に応答しませんでした。Claude Code に Claude のサブスクリプションでログインしているか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Control이 제때 응답하지 않았습니다. Claude Code가 Claude 구독으로 로그인되어 있는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Control reageerde niet op tijd. Controleer of Claude Code is ingelogd met je Claude-abonnement."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Control nie odpowiedział na czas. Sprawdź, czy Claude Code jest zalogowany przy użyciu Twojej subskrypcji Claude."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Remote Control não respondeu a tempo. Verifique se o Claude Code está conectado com a sua assinatura do Claude."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Control не ответил вовремя. Убедитесь, что в Claude Code выполнен вход с вашей подпиской Claude."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote Control zamanında yanıt vermedi. Claude Code'da Claude aboneliğinle oturum açtığını kontrol et."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
