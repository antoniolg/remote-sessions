          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É um programa pequeno que permite ao celular ver suas conversas. Ele roda em segundo plano e só responde aos celulares que você parear."
          }
        },
        "ru" : {
