    "Claude Code will be able to read, edit and run files in %@. Trust it only if it's your own project." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code podrá leer, editar y ejecutar archivos en %@. Confía solo si es un proyecto tuyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code pourra lire, modifier et exécuter des fichiers dans %@. Ne lui faites confiance que s’il s’agit de votre propre projet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code kann dann in %@ Dateien lesen, bearbeiten und ausführen. Vertraue ihm nur, wenn es dein eigenes Projekt ist."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code potrà leggere, modificare ed eseguire file in %@. Fidati solo se è un tuo progetto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claude Code poderá ler, editar e executar arquivos em %@. Confie apenas se for um projeto seu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code は %@ 内のファイルを読み取り、編集、実行できるようになります。自分のプロジェクトの場合のみ信頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code가 %@의 파일을 읽고, 편집하고, 실행할 수 있게 됩니다. 본인 프로젝트인 경우에만 신뢰하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 将能够读取、编辑和运行 %@ 中的文件。仅当这是你自己的项目时才信任它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 將能讀取、編輯和執行 %@ 中的檔案。只有在這是你自己的專案時才信任它。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code сможет читать, изменять и запускать файлы в %@. Доверяйте, только если это ваш собственный проект."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code kan dan bestanden in %@ lezen, bewerken en uitvoeren. Vertrouw hem alleen als het je eigen project is."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, %@ içindeki dosyaları okuyabilecek, düzenleyebilecek ve çalıştırabilecek. Yalnızca kendi projense güven."
          }
        },
        "pl" : {
