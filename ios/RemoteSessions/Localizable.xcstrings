    "View your Claude Code conversations from your phone and continue any of them with a tap." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir deine Unterhaltungen mit Claude Code auf dem Handy an und setze jede mit einem Tippen fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta tus conversaciones de Claude Code desde el móvil y continúa cualquiera con un toque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez vos conversations Claude Code depuis votre téléphone et reprenez-en une d’un simple toucher."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat percakapan Claude Code Anda dari ponsel dan lanjutkan yang mana saja dengan sekali ketuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta le tue conversazioni di Claude Code dal telefono e riprendine una con un tocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code の会話をスマートフォンで確認し、タップひとつで続きを再開できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰에서 Claude Code 대화를 확인하고 탭 한 번으로 이어서 진행하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk je Claude Code-gesprekken op je telefoon en ga met één tik verder met elk gesprek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeglądaj rozmowy z Claude Code na telefonie i kontynuuj dowolną jednym dotknięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja suas conversas do Claude Code no celular e continue qualquer uma com um toque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просматривайте разговоры Claude Code с телефона и продолжайте любой одним касанием."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code sohbetlerini telefonundan gör ve istediğine tek dokunuşla devam et."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在手机上查看你的 Claude Code 对话，轻点一下即可继续任意对话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在手機上查看你的 Claude Code 對話，點一下即可繼續任何一段對話。"
          }
        }
      }
    },
    "When it finishes, the terminal will show a QR code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danach zeigt das Terminal einen QR-Code an."
