    },
    "You can now see your conversations while you're on the same Wi-Fi as your computer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst deine Unterhaltungen jetzt sehen, solange du im selben WLAN wie dein Computer bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya puedes ver tus conversaciones mientras estés en la misma wifi que el ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez maintenant voir vos conversations tant que vous êtes sur le même Wi-Fi que l’ordinateur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekarang Anda dapat melihat percakapan selama berada di Wi-Fi yang sama dengan komputer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora puoi vedere le tue conversazioni mentre sei sulla stessa Wi-Fi del computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータと同じ Wi-Fi に接続している間、会話を見られるようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 컴퓨터와 같은 Wi-Fi에 있는 동안 대화를 볼 수 있습니다."
