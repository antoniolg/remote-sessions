    "This computer no longer recognizes this phone. Scan its code again with `remote-sessions pair`." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Computer erkennt dieses Handy nicht mehr. Scanne seinen Code erneut mit `remote-sessions pair`."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ordenador ya no reconoce este móvil. Vuelve a escanear su código con `remote-sessions pair`."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ordinateur ne reconnaît plus ce téléphone. Scannez à nouveau son code avec `remote-sessions pair`."
